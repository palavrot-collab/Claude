# --- Database ---
# Local Postgres:
#   postgresql://USER:PASS@localhost:5432/manager_lms?schema=public
# Neon (production / Vercel) — for serverless, use the *pooled* URL:
#   postgresql://USER:PASS@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL="postgresql://lms:lms@localhost:5432/manager_lms?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
# In production this should be the public URL, e.g. https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
